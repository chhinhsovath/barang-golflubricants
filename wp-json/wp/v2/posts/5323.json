-top:0;\nmargin-bottom:10px;\n}\n.hr.av-5gql2z-8464e24b54cbdfbcca89a5cbe0936467 .hr-inner{\nwidth:50px;\nborder-color:#ed1c24;\n}\n<\/style>\n<div  class='hr av-5gql2z-8464e24b54cbdfbcca89a5cbe0936467 hr-custom  avia-builder-el-1  el_after_av_heading  el_before_av_one_half  hr-left hr-icon-no'><span class='hr-inner inner-border-av-border-fat'><span class=\"hr-inner-style\"><\/span><\/span><\/div>\n<div class='flex_column_table av-gx8yj-94c7543a5cd5b70f8930f1b45b68105d sc-av_one_half av-equal-height-column-flextable'><div  class='flex_column av-gx8yj-94c7543a5cd5b70f8930f1b45b68105d av_one_half  avia-builder-el-2  el_after_av_hr  el_before_av_one_half  first flex_column_table_cell av-equal-height-column av-align-top  '     ><section  class='av_textblock_section av-mnhd8y6b-e58a4eeaa2ddcc103410d83bb00be4b0 '   itemscope=\"itemscope\" itemtype=\"https:\/\/schema.org\/BlogPosting\" itemprop=\"blogPost\" ><div class='avia_textblock'  itemprop=\"text\" ><p data-start=\"73\" data-end=\"195\">Z przyjemno\u015bci\u0105 informujemy, \u017ce Venol we\u017amie udzia\u0142 w Polsko-Egipskim Forum Biznesu, kt\u00f3re odb\u0119dzie si\u0119 <strong>11 maja 2026 roku<\/strong>.<\/p>\n<p data-start=\"197\" data-end=\"503\">W wydarzeniu uczestniczy\u0107 b\u0119d\u0105 przedstawiciele Zagranicznego Biura Handlowego Polskiej Agencji Inwestycji i Handlu w Kairze, Wydzia\u0142u Afryki i Bliskiego Wschodu PAIH, Ambasady Rzeczypospolitej Polskiej w Kairze, Banku Gospodarstwa Krajowego, Agencji Rozwoju Przemys\u0142u oraz wybrane polskie przedsi\u0119biorstwa.<\/p>\n<p data-start=\"505\" data-end=\"635\">Cieszymy si\u0119, \u017ce mo\u017cemy by\u0107 cz\u0119\u015bci\u0105 tak wa\u017cnego wydarzenia wspieraj\u0105cego rozw\u00f3j wsp\u00f3\u0142pracy gospodarczej pomi\u0119dzy Polsk\u0105 a Egiptem.<\/p>\n<p data-start=\"637\" data-end=\"682\">Zapraszamy do rozm\u00f3w i spotka\u0144 podczas Forum.<\/p>\n<\/div><\/section><\/div><div class='av-flex-placeholder'><\/div><div  class='flex_column av-2794a3-273bbf8bb532904d9a42034de2fb55c9 av_one_half  avia-builder-el-4  el_after_av_one_half  avia-builder-el-last  flex_column_table_cell av-equal-height-column av-align-top  '     ><style type=\"text\/css\" data-created_by=\"avia_inline_auto\" id=\"style-css-av-mnhda2bf-51b46dbe56710f73119dd55424ea8375\">\n.avia-image-container.av-mnhda2bf-51b46dbe56710f73119dd55424ea8375 img.avia_image{\nbox-shadow:none;\n}\n.avia-image-container.av-mnhda2bf-51b46dbe56710f73119dd55424ea8375 .av-image-caption-overlay-center{\ncolor:#ffffff;\n}\n<\/style>\n<div  class='avia-image-container av-mnhda2bf-51b46dbe56710f73119dd55424ea8375 av-styling- avia-align-center  avia-builder-el-5  avia-builder-el-no-sibling '   itemprop=\"image\" itemscope=\"itemscope\" itemtype=\"https:\/\/schema.org\/ImageObject\" ><div class=\"avia-image-container-inner\"><div class=\"avia-image-overlay-wrap\"><img decoding=\"async\" fetchpriority=\"high\" class='wp-image-5324 avia-img-lazy-loading-not-5324 avia_image ' src=\"https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_PL-1030x1030.png\" alt='' title='KAIR_PL'  height=\"1030\" width=\"1030\"  itemprop=\"thumbnailUrl\" srcset=\"https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_PL-1030x1030.png 1030w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_PL-300x300.png 300w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_PL-80x80.png 80w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_PL-768x768.png 768w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_PL-1536x1536.png 1536w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_PL-36x36.png 36w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_PL-180x180.png 180w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_PL-1500x1500.png 1500w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_PL-705x705.png 705w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_PL.png 2000w\" sizes=\"(max-width: 1030px) 100vw, 1030px\" \/><\/div><\/div>