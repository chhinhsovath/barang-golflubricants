9d28e96992d31d2{\nmargin-top:0;\nmargin-bottom:10px;\n}\n.hr.av-av_hr-e20845366ecf4191d9d28e96992d31d2 .hr-inner{\nwidth:50px;\nborder-color:#ed1c24;\n}\n<\/style>\n<div  class='hr av-av_hr-e20845366ecf4191d9d28e96992d31d2 hr-custom  avia-builder-el-1  el_after_av_heading  el_before_av_one_half  hr-left hr-icon-no'><span class='hr-inner inner-border-av-border-fat'><span class=\"hr-inner-style\"><\/span><\/span><\/div>\n<div class='flex_column_table av-av_one_half-8cdbb378864195f7b9517e600bbf174b sc-av_one_half av-equal-height-column-flextable'><div  class='flex_column av-av_one_half-8cdbb378864195f7b9517e600bbf174b av_one_half  avia-builder-el-2  el_after_av_hr  el_before_av_one_half  first flex_column_table_cell av-equal-height-column av-align-top  '     ><section  class='av_textblock_section av-mownt6pu-22d3a6cbfefb6eb92fb9a31ef26e8e6b '   itemscope=\"itemscope\" itemtype=\"https:\/\/schema.org\/BlogPosting\" itemprop=\"blogPost\" ><div class='avia_textblock'  itemprop=\"text\" ><p data-start=\"2239\" data-end=\"2359\">Nous avons le plaisir d\u2019annoncer que Venol participera au Forum d\u2019Affaires Pologne-\u00c9gypte qui se tiendra le <strong>11 mai 2026<\/strong>.<\/p>\n<p data-start=\"2361\" data-end=\"2720\">L\u2019\u00e9v\u00e9nement r\u00e9unira des repr\u00e9sentants du Bureau Commercial \u00c9tranger de l\u2019Agence Polonaise d\u2019Investissement et de Commerce au Caire, du D\u00e9partement Afrique et Moyen-Orient de la PAIH, de l\u2019Ambassade de la R\u00e9publique de Pologne au Caire, de Bank Gospodarstwa Krajowego, de l\u2019Agence de D\u00e9veloppement Industriel ainsi que des entreprises polonaises s\u00e9lectionn\u00e9es.<\/p>\n<p data-start=\"2722\" data-end=\"2869\">Nous sommes heureux de faire partie d\u2019un \u00e9v\u00e9nement aussi important pour le d\u00e9veloppement de la coop\u00e9ration \u00e9conomique entre la Pologne et l\u2019\u00c9gypte.<\/p>\n<p data-start=\"2871\" data-end=\"2949\">Nous vous invitons \u00e0 nous rencontrer et \u00e0 \u00e9changer avec nous pendant le Forum.<\/p>\n<\/div><\/section><\/div><div class='av-flex-placeholder'><\/div><div  class='flex_column av-av_one_half-421c1bf5d4c122db8f22821bc87bc328 av_one_half  avia-builder-el-4  el_after_av_one_half  avia-builder-el-last  flex_column_table_cell av-equal-height-column av-align-top  '     ><style type=\"text\/css\" data-created_by=\"avia_inline_auto\" id=\"style-css-av-mowntn76-63c7ca8254e9c976d90b6caea8c6219a\">\n.avia-image-container.av-mowntn76-63c7ca8254e9c976d90b6caea8c6219a img.avia_image{\nbox-shadow:none;\n}\n.avia-image-container.av-mowntn76-63c7ca8254e9c976d90b6caea8c6219a .av-image-caption-overlay-center{\ncolor:#ffffff;\n}\n<\/style>\n<div  class='avia-image-container av-mowntn76-63c7ca8254e9c976d90b6caea8c6219a av-styling- avia-align-center  avia-builder-el-5  avia-builder-el-no-sibling '   itemprop=\"image\" itemscope=\"itemscope\" itemtype=\"https:\/\/schema.org\/ImageObject\" ><div class=\"avia-image-container-inner\"><div class=\"avia-image-overlay-wrap\"><img decoding=\"async\" fetchpriority=\"high\" class='wp-image-5336 avia-img-lazy-loading-not-5336 avia_image ' src=\"https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_EN-2-1030x1030.png\" alt='' title='KAIR_EN'  height=\"1030\" width=\"1030\"  itemprop=\"thumbnailUrl\" srcset=\"https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_EN-2-1030x1030.png 1030w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_EN-2-300x300.png 300w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_EN-2-80x80.png 80w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_EN-2-768x768.png 768w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_EN-2-1536x1536.png 1536w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_EN-2-36x36.png 36w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_EN-2-180x180.png 180w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/KAIR_EN-2-1500x1500.png 1500w, https:\/\/venol.de\/wp-content\/uploads\/2026\/