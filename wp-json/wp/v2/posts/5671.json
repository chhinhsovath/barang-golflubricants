op:0;\nmargin-bottom:10px;\n}\n.hr.av-av_hr-e20845366ecf4191d9d28e96992d31d2 .hr-inner{\nwidth:50px;\nborder-color:#ed1c24;\n}\n<\/style>\n<div  class='hr av-av_hr-e20845366ecf4191d9d28e96992d31d2 hr-custom  avia-builder-el-1  el_after_av_heading  el_before_av_one_half  hr-left hr-icon-no'><span class='hr-inner inner-border-av-border-fat'><span class=\"hr-inner-style\"><\/span><\/span><\/div>\n<div class='flex_column_table av-av_one_half-8cdbb378864195f7b9517e600bbf174b sc-av_one_half av-equal-height-column-flextable'><div  class='flex_column av-av_one_half-8cdbb378864195f7b9517e600bbf174b av_one_half  avia-builder-el-2  el_after_av_hr  el_before_av_one_half  first flex_column_table_cell av-equal-height-column av-align-top  '     ><section  class='av_textblock_section av-mrsvx16m-50039cbf836bea05c17cc111b51816a0 '   itemscope=\"itemscope\" itemtype=\"https:\/\/schema.org\/BlogPosting\" itemprop=\"blogPost\" ><div class='avia_textblock'  itemprop=\"text\" ><p class=\"PDq2pG_selectionAnchorContainer\" data-start=\"376\" data-end=\"509\"><strong>Vom 8. bis 12. September 2026<\/strong> sind wir auf einer der wichtigsten Messen der Automobilbranche vertreten &#8211; der Automechanika Frankfurt.<\/p>\n<p data-start=\"511\" data-end=\"535\"><strong data-start=\"511\" data-end=\"535\">Halle 12 | Stand E47<\/strong><\/p>\n<p data-start=\"537\" data-end=\"713\">Wir laden Sie herzlich ein, unseren Messestand zu besuchen. Dort pr\u00e4sentieren wir unser Angebot an hochwertigen Schmier\u00f6len, darunter Produkte auf PAO-Basis, sowie \u00d6ladditiven.<\/p>\n<p data-start=\"715\" data-end=\"877\">Dies ist eine hervorragende Gelegenheit, unsere L\u00f6sungen kennenzulernen, \u00fcber m\u00f6gliche Formen der Zusammenarbeit zu sprechen und unser Team pers\u00f6nlich zu treffen.<\/p>\n<p data-start=\"879\" data-end=\"906\">Wir sehen uns in Frankfurt!<\/p>\n<\/div><\/section><\/div><div class='av-flex-placeholder'><\/div><div  class='flex_column av-av_one_half-421c1bf5d4c122db8f2282