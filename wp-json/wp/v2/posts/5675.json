n-top:0;\nmargin-bottom:10px;\n}\n.hr.av-av_hr-e20845366ecf4191d9d28e96992d31d2 .hr-inner{\nwidth:50px;\nborder-color:#ed1c24;\n}\n<\/style>\n<div  class='hr av-av_hr-e20845366ecf4191d9d28e96992d31d2 hr-custom  avia-builder-el-1  el_after_av_heading  el_before_av_one_half  hr-left hr-icon-no'><span class='hr-inner inner-border-av-border-fat'><span class=\"hr-inner-style\"><\/span><\/span><\/div>\n<div class='flex_column_table av-av_one_half-8cdbb378864195f7b9517e600bbf174b sc-av_one_half av-equal-height-column-flextable'><div  class='flex_column av-av_one_half-8cdbb378864195f7b9517e600bbf174b av_one_half  avia-builder-el-2  el_after_av_hr  el_before_av_one_half  first flex_column_table_cell av-equal-height-column av-align-top  '     ><section  class='av_textblock_section av-mrsvyeax-ad7ed84285f43359611c00bbf510b74b '   itemscope=\"itemscope\" itemtype=\"https:\/\/schema.org\/BlogPosting\" itemprop=\"blogPost\" ><div class='avia_textblock'  itemprop=\"text\" ><p class=\"PDq2pG_selectionAnchorContainer\" data-start=\"922\" data-end=\"1068\"><strong>From 8 to 12 September 2026<\/strong>, we will be exhibiting at one of the most important trade fairs for the automotive industry &#8211; Automechanika Frankfurt.<\/p>\n<p data-start=\"1070\" data-end=\"1093\"><strong data-start=\"1070\" data-end=\"1093\">Hall 12 | Stand E47<\/strong><\/p>\n<p data-start=\"1095\" data-end=\"1258\">We warmly invite you to visit our stand, where we will showcase our range of high-quality lubricating oils, including PAO-based products, as well as oil additives.<\/p>\n<p data-start=\"1260\" data-end=\"1378\">This is an excellent opportunity to discover our solutions, discuss potential cooperation and meet our team in person.<\/p>\n<p data-start=\"1380\" data-end=\"1401\">See you in Frankfurt!<\/p>\n<\/div><\/section><\/div><div class='av-flex-placeholder'><\/div><div  class='flex_column av-av_one_half-421c1bf5d4c122db8f22821bc87bc328 av_one_half  avia-builder-el-4  el_after_av_one_half  avia-bu