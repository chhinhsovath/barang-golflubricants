b836299\">\n#top .hr.av-5bclcd-4c2a3f5a30450d06a691d3c22b836299{\nmargin-top:0;\nmargin-bottom:10px;\n}\n.hr.av-5bclcd-4c2a3f5a30450d06a691d3c22b836299 .hr-inner{\nwidth:50px;\nborder-color:#ed1c24;\n}\n<\/style>\n<div  class='hr av-5bclcd-4c2a3f5a30450d06a691d3c22b836299 hr-custom  avia-builder-el-1  el_after_av_heading  el_before_av_one_half  hr-left hr-icon-no'><span class='hr-inner inner-border-av-border-fat'><span class=\"hr-inner-style\"><\/span><\/span><\/div>\n<div  class='flex_column av-43yb25-2b8808b9a87bdcf7d4023d2197318de2 av_one_half  avia-builder-el-2  el_after_av_hr  el_before_av_one_half  first flex_column_div  '     ><section  class='av_textblock_section av-m0nd9hww-d58965708959297b7e166464b9192a22 '   itemscope=\"itemscope\" itemtype=\"https:\/\/schema.org\/BlogPosting\" itemprop=\"blogPost\" ><div class='avia_textblock'  itemprop=\"text\" ><p>Venol Atom\u00f3wki \u0141\u00f3d\u017a a pris la deuxi\u00e8me place du championnat polonais de rugby \u00e0 7 f\u00e9minin U16, qui s\u2019est d\u00e9roul\u00e9 le 17 juin 2023 \u00e0 Lublin.<\/p>\n<p>Pendant le tournoi Venol, Atom\u00f3wki \u0141\u00f3d\u017a a affront\u00e9 des \u00e9quipes : B\u0142yskawice Rugby Rzesz\u00f3w, Amazonki Budowlani Lublin, RC Cz\u0119stochowa, RZKS Juvenalia Krak\u00f3w.<\/p>\n<p>Nous f\u00e9licitons vivement les joueurs et attendons avec impatience d\u2019autres succ\u00e8s !<\/p>\n<\/div><\/section><\/div><div  class='flex_column av-2lmptp-4da520229cb0f043680cc5483adb9019 av_one_half  avia-builder-el-4  el_after_av_one_half  el_before_av_button  flex_column_div  '     ><style type=\"text\/css\" data-created_by=\"avia_inline_auto\" id=\"style-css-av-m0ndawnd-b00ced97ba106defe887f5a8b081e789\">\n.avia-image-container.av-m0ndawnd-b00ced97ba106defe887f5a8b081e789 img.avia_image{\nbox-shadow:none;\n}\n.avia-image-container.av-m0ndawnd-b00ced97ba106defe887f5a8b081e789 .av-image-caption-overlay-center{\ncolor:#ffffff;\n}\n<\/style>\n<div  class='avia-image-container av-m0ndawnd-