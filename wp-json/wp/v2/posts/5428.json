b85fa095a99f66 .hr-inner{\nwidth:50px;\nborder-color:#ed1c24;\n}\n<\/style>\n<div  class='hr av-5g8dgk-6e4b1f8664f8c336c0b85fa095a99f66 hr-custom  avia-builder-el-1  el_after_av_heading  el_before_av_one_half  hr-left hr-icon-no'><span class='hr-inner inner-border-av-border-fat'><span class=\"hr-inner-style\"><\/span><\/span><\/div>\n<div class='flex_column_table av-45f25w-20110c1a7b2fa56bce6f96b9d58d3755 sc-av_one_half av-equal-height-column-flextable'><div  class='flex_column av-45f25w-20110c1a7b2fa56bce6f96b9d58d3755 av_one_half  avia-builder-el-2  el_after_av_hr  el_before_av_one_half  first flex_column_table_cell av-equal-height-column av-align-top  '     ><section  class='av_textblock_section av-mq6lsyqp-2fe0e7cc61d5afd669b3c18cc3fd7478 '   itemscope=\"itemscope\" itemtype=\"https:\/\/schema.org\/BlogPosting\" itemprop=\"blogPost\" ><div class='avia_textblock'  itemprop=\"text\" ><p data-start=\"115\" data-end=\"301\">Dieses Mal werden wir in Zusammenarbeit mit der Polnischen Agentur f\u00fcr Investitionen und Handel (PAIH) auf der <strong data-start=\"226\" data-end=\"255\">Automechanika Mexico City<\/strong> vom <strong data-start=\"260\" data-end=\"285\">08. bis 10. Juli 2026<\/strong> vertreten sein.<\/p>\n<p data-start=\"303\" data-end=\"401\">Wir laden Sie herzlich ein, den Polnischen Nationalpavillon am <strong data-start=\"370\" data-end=\"388\">Stand Nr. 4844<\/strong> zu besuchen.<\/p>\n<p data-start=\"403\" data-end=\"591\">Nutzen Sie die Gelegenheit, mit uns \u00fcber neue Gesch\u00e4ftsm\u00f6glichkeiten und eine m\u00f6gliche Zusammenarbeit zu sprechen. Vereinbaren Sie gerne vorab einen Termin per E-Mail: <a href=\"mailto:export@venol.de\">export@venol.de<\/a><\/p>\n<p data-start=\"593\" data-end=\"616\">Bis bald in Mexiko!<\/p>\n<\/div><\/section><\/div><div class='av-flex-placeholder'><\/div><div  class='flex_column av-28b9z8-ac84edc55b5de7ab7dd99f1e2d8041ee av_one_half  avia-builder-el-4  el_after_av_one_half  avia-builder-el-last  flex_column