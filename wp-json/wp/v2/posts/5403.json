4191d9d28e96992d31d2 .hr-inner{\nwidth:50px;\nborder-color:#ed1c24;\n}\n<\/style>\n<div  class='hr av-av_hr-e20845366ecf4191d9d28e96992d31d2 hr-custom  avia-builder-el-1  el_after_av_heading  el_before_av_one_half  hr-left hr-icon-no'><span class='hr-inner inner-border-av-border-fat'><span class=\"hr-inner-style\"><\/span><\/span><\/div>\n<div class='flex_column_table av-av_one_half-8cdbb378864195f7b9517e600bbf174b sc-av_one_half av-equal-height-column-flextable'><div  class='flex_column av-av_one_half-8cdbb378864195f7b9517e600bbf174b av_one_half  avia-builder-el-2  el_after_av_hr  el_before_av_one_half  first flex_column_table_cell av-equal-height-column av-align-top  '     ><section  class='av_textblock_section av-mpnvbkt0-610cafc184d7af08916dbb157a1f5a82 '   itemscope=\"itemscope\" itemtype=\"https:\/\/schema.org\/BlogPosting\" itemprop=\"blogPost\" ><div class='avia_textblock'  itemprop=\"text\" ><p class=\"isSelectedEnd\"><strong>Du 22 au 26 juin 2026<\/strong>, nous exposerons au China International Supply Chain Expo (CISCE) \u00e0 P\u00e9kin.<\/p>\n<p class=\"isSelectedEnd\">Il s\u2019agit d\u2019une \u00e9tape importante pour nous, rendue possible gr\u00e2ce \u00e0 notre coop\u00e9ration strat\u00e9gique avec l\u2019Agence Polonaise d\u2019Investissement et de Commerce (PAIH).<\/p>\n<p class=\"isSelectedEnd\"><strong>O\u00f9 nous trouver ?<\/strong><\/p>\n<p class=\"isSelectedEnd\">Au salon : Venez visiter notre stand, \u00e9changeons sur le business et d\u00e9couvrez les projets sur lesquels nous avons travaill\u00e9.<\/p>\n<p class=\"isSelectedEnd\">En ville : Tout au long de la semaine, nous r\u00e9serverons du temps pour des r\u00e9unions professionnelles, du networking et des caf\u00e9s-rencontres.<\/p>\n<p class=\"isSelectedEnd\"><strong>D\u00e9tails :<\/strong><\/p>\n<p class=\"isSelectedEnd\">\u00c9v\u00e9nement : 4th CISCE | cisce.org.cn<br \/>\nLieu : China International Exhibition Center (Shunyi Venue), P\u00e9kin<\/p>\n<p class=\"isSelectedEnd\">Planifions une rencontre !<\/p>\n<p class=\"isSelectedEnd\">Contactez-nous pour r\u00e9server un cr\u00e9neau.<\/p>\n<p>\u00c0 bient\u00f4t \u00e0 P\u00e9kin !<\/p>\n<\/div><\/section><\/div><div class='av-flex-placeholder'><\/div><div  class='flex_column av-av_one_half-421c1bf5d4c122db8f22821bc87bc328 av_one_half  avia-builder-el-4  el_after_av_one_half  avia-builder-el-last  flex_column_table_cell av-equal-height-column av-align-top  '     ><style type=\"text\/css\" data-created_by=\"avia_inline_auto\" id=\"style-css-av-mpnvb9xu-ac931be3b48a031cdf067baf9ff1d0ed\">\n.avia-image-container.av-mpnvb9xu-ac931be3b48a031cdf067baf9ff1d0ed img.avia_image{\nbox-shadow:none;\n}\n.avia-image-container.av-mpnvb9xu-ac931be3b48a031cdf067baf9ff1d0ed .av-image-caption-overlay-center{\ncolor:#ffffff;\n}\n<\/style>\n<div  class='avia-image-container av-mpnvb9xu-ac931be3b48a031cdf067baf9ff1d0ed av-styling- avia-align-center  avia-builder-el-5  avia-builder-el-no-sibling '   itemprop=\"image\" itemscope=\"itemscope\" itemtype=\"https:\/\/schema.org\/ImageObject\" ><div class=\"avia-image-container-inner\"><div class=\"avia-image-overlay-wrap\"><img decoding=\"async\" fetchpriority=\"high\" class='wp-image-5404 avia-img-lazy-loading-not-5404 avia_image ' src=\"https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/venol-china-international-exhibition-center-4-1030x1030.jpg\" alt='' title='venol-china-international-exhibition-center'  height=\"1030\" width=\"1030\"  itemprop=\"thumbnailUrl\" srcset=\"https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/venol-china-international-exhibition-center-4-1030x1030.jpg 1030w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/venol-china-international-exhibition-center-4-300x300.jpg 300w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/venol-china-international-exhibition-center-4-80x80.jpg 80w, https:\/\/venol.de\/wp-content\/uploads\/2026\/05\/venol-china-international-exhibition-center-4-768x768.jpg 768w, https:\/\/venol.de\/wp-content\/uploads